      },
      "route": "/dashboard/warehouse/movements",
      "api": [
        {
          "id": "listStockMovements",
          "method": "GET",
          "path": "/stock/movements",
          "request": {
            "page": "state الصفحة",
            "per_page": "state (20 افتراضي، 50، 100)",
            "location_id": "filters.locationId",
            "item_id": "filters.itemId",
            "batch_id": "filters.batchId",
            "from": "filters.range.from",
            "to": "filters.range.to"
          },
          "success": {
            "status": 200,
            "model": "Paginated<StockMovement>"
          }
        },
        {
          "id": "listLocations",
          "method": "GET",
          "path": "/locations",
          "success": {
            "status": 200,
            "model": "Location[]"
          },
          "note": "خيارات فلتر الموقع"
        },
        {
          "id": "listItems",
          "method": "GET",
          "path": "/items",
          "success": {
            "status": 200,
            "model": "Paginated<Item>"
          },
          "note": "خيارات فلتر الصنف (q من الخادم)"
        },
        {
          "id": "listBatches",
          "method": "GET",
          "path": "/batches",
          "request": {
            "item_id": "filters.itemId"
          },
          "success": {
            "status": 200,
            "model": "Paginated<Batch>"
          },
          "note": "خيارات فلتر الدفعة: دفعات الصنف المختار. المسار موجود في العقد (item_id وpage وper_page حتى 100)"
        }
      ],
      "view_props": {
        "movements": "Loadable<{ data: StockMovement[]; meta: PaginationMeta }> ← listStockMovements (data وmeta من رد Paginated)",
        "locations": "Location[] ← listLocations",
        "items": "ItemRef[] ← listItems",
        "batches": "BatchRef[] ← listBatches (دفعات filters.itemId إن وُجد)",
        "filters": "{ locationId, itemId, batchId, range: { from, to } } حالة الصفحة (الرابط أو state). تغيّرها يعيد الصفحة إلى 1",
        "onFiltersChange": "يحدّث الفلاتر، ويعيد page إلى 1، ويعيد الطلب",
        "onPageChange": "page ← الرقم ويعيد الطلب",
        "onPerPageChange": "per_page ← القيمة، وpage = 1",
        "today": "اليوم بتوقيت دمشق (حدّ منتقي الفترة وحالة الدفعات)",
